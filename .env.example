# PostgreSQL Database Configuration
POSTGRES_DB=awaio_db
POSTGRES_USER=awaio_user
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5433
POSTGRES_HOST=localhost

# Metabase Configuration
METABASE_PORT=3000
METABASE_DB=metabase_app

# pgAdmin Configuration
PGADMIN_PORT=5050
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=admin

# MindsDB Configuration
MINDSDB_PORT=47334
MINDSDB_MYSQL_PORT=47335
MINDSDB_MONGODB_PORT=47336

# Awaio API Configuration
AWAIO_API_BASE_URL=https://api.awaio.com/v1.1.0
AWAIO_AUTH_URL=https://api.awaio.com/auth/token
AWAIO_CLIENT_ID=your_client_id
AWAIO_CLIENT_SECRET=your_client_secret

# Gemini API (for chat_app / MindsDB)
GEMINI_KEY=your_gemini_key

# Privacy/Anonymization Settings (GDPR)
# When ANONYMIZE_USERS=true, Awaio user_ids are replaced by HMAC-SHA256
# pseudonyms keyed with ANONYMIZE_SALT. Same user_id + salt -> same pseudonym
# across imports (longitudinal analysis works). Without the salt the pseudonym
# cannot be reversed.
#
# ANONYMIZE_SALT is REQUIRED when ANONYMIZE_USERS=true. Generate once with:
#     openssl rand -hex 32
# Store it in .env AND a secret manager (Bitwarden `dev/awaio`). Losing the
# salt permanently breaks correlation between old and new imports — you cannot
# recover it.
ANONYMIZE_USERS=true
ANONYMIZE_SALT=

# Time zone
TZ=Europe/Stockholm
